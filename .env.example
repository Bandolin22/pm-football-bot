# Required only when running with --live
# Polygon EOA private key. The Watchlist keeper UI saves this into .env.
PK=

# Deposit wallet shown on polymarket.com (not the EOA). Auto-filled from PK when possible.
FUNDER=

# 3 = deposit wallet (required). 1 = Magic/email proxy. 2 = Gnosis Safe.
# 0 is treated as 3 — the venue rejects EOA makers.
SIGNATURE_TYPE=3

CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Optional fallback. Form/H2H default is football-data.co.uk CSVs (no key).
# Free token from https://www.football-data.org/client/register
# Used only if a cup/league has no results CSV.
FOOTBALL_DATA_TOKEN=

# Optional. Claude explains 1X2 disagreement; it is never a model feature.
ANTHROPIC_API_KEY=

# Optional. Telegram watchlist alert ~3 hours before kickoff.
# Create a bot with @BotFather, then message it and get chat id from getUpdates.
# On GitHub / Render / Railway set these as secrets or env vars. Do not commit them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
